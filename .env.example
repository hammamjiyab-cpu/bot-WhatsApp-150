# Copy this file to ".env" and fill it in.  (Never share or upload the real .env)

# ---- Developer (the owner who can use developer-only commands) ----
# Your WhatsApp number: country code + number, digits only. Example: 9677XXXXXXXX
DEV_NUMBER=
DEV_NAME=Hammam

# ---- The number the bot will run on (can be the same as DEV_NUMBER) ----
# Leave empty to be asked for it in the terminal on first run.
BOT_NUMBER=

# ---- Language of ALL bot replies: ar | en | fr | es | tr | de | ru | id | hi | ur ... ----
BOT_LANG=ar

# ---- Optional API keys (some commands need them; leave empty if you don't use them) ----
GROQ_API_KEY=
GLADIA_API_KEY=

# ---- Optional ----
# FIREBASE_KEY_FILE=./firebase-service-account.json
# PANEL_PORT=3000
